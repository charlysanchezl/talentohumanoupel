{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "ignorePatterns": ["server/scripts/**", "dist/**", "build/**", "node_modules/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off",
    "react-hooks/exhaustive-deps": "off",
    "no-unused-vars": "off"
  }
}
