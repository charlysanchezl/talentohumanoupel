# ===================================================
# UPEL SIGOA - Plantilla de Variables de Entorno
# Copie este archivo como .env y ajuste sus valores de entorno
# ===================================================

# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=su_password_seguro_de_mysql
DB_NAME=upel_talento_humano

# Puerto del Servidor Express
PORT=3001

# Clave Secreta Criptográfica para Tokens JWT
# En producción, genere un hash aleatorio de 64 caracteres hex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=coloque_aqui_su_clave_secreta_de_produccion_aleatoria
JWT_EXPIRES_IN=7d

# Google Gemini AI Vision (Extracción Inteligente de Documentos)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=coloque_aqui_su_gemini_api_key
